# Stack variables for the Portainer deployment. Copy the values you need into
# Portainer's stack environment variables — this file itself contains no secrets and
# is never deployed.
#
# Values below are the ones this design chose; the reasoning for each is in
# specs/001-docling-pdf2md-stack/contracts/stack.md.

# --- required -------------------------------------------------------------------

# Any long random string. It is not a user credential: nobody is asked for it. It
# exists so that if the engine's port were ever published by mistake, the engine is
# not immediately open on the LAN (research.md R9).
#   generate with: openssl rand -hex 32
PDF2MD_ENGINE_API_KEY=

# The folder on the Mac mini that receives converted Markdown. It must exist and be
# writable before the first deploy; this is the only host-side preparation step.
OUTBOX_HOST_PATH=/Users/<you>/pdf2md-outbox

# --- images ---------------------------------------------------------------------

# Both images are pulled from GHCR at deploy time and pinned by tag AND digest. The tag
# is for humans; the digest is the pin, because a tag can be re-pointed upstream (FR-032).
# Overriding either of these means deploying something other than what the stack file
# pins — do it deliberately, and re-run ops/verify-engine-image.sh afterwards.
#
# Never `latest`, and never a `-slim` engine variant: those ship without model weights,
# so they deploy cleanly, report healthy, and fail on the first scanned page.
#
# The engine image's own environment confirms the models path this deployment relies on:
#   DOCLING_SERVE_ARTIFACTS_PATH=/opt/app-root/src/.cache/docling/models
ENGINE_IMAGE=ghcr.io/docling-project/docling-serve-cpu:v1.18.0@sha256:6aa1b1428b5c83db2a4fc3431d99902ef115d9e1ce13eed0f716d23ed9d9a098

# Published by .github/workflows/publish.yml on a `v*` tag; the digest is printed in that
# workflow's job summary.
WEB_IMAGE=ghcr.io/marrothm/pdf2md-web:1.2.0@sha256:f449e41acbc1eb81d352ad8c590a0f2e45c8c7503e836beb9e7ad6f91db9a701

# --- web service ----------------------------------------------------------------

WEB_PORT=8080
PDF2MD_MAX_UPLOAD_BYTES=209715200        # 200 MB; keep at or below the engine limit
PDF2MD_JOB_TIMEOUT_SECONDS=2700          # 45 min watchdog, above the engine's own ceiling
PDF2MD_POLL_INTERVAL_SECONDS=2
PDF2MD_INBOX_RETENTION_HOURS=48          # delete an uploaded PDF this long after success
PDF2MD_FAILED_INBOX_RETENTION_DAYS=14    # keep failed uploads longer so retry stays possible
PDF2MD_SUSPECT_MIN_CHARS_PER_PAGE=50     # below this yield, report "check output" (FR-029)
PDF2MD_JOB_HISTORY_DAYS=30               # history pruning; never touches the outbox
PDF2MD_MIN_FREE_BYTES=67108864           # refuse uploads below 64 MB free, naming the folder
PDF2MD_ENGINE_HEALTH_PATH=/ready         # /ready gates on model loading; /health does not
# --- splitting (FR-033 through FR-037) ------------------------------------------

# Documents longer than this are converted in parts. Sized to the engine's *time* ceiling
# rather than its page ceiling: at 10s/page a 100-page part takes ~1000s against
# DOCLING_MAX_DOCUMENT_TIMEOUT of 2400s. A value chosen to sit just under the 2000-page
# limit would time out instead. Set it from measured throughput (research.md R12).
PDF2MD_PART_MAX_PAGES=100

# Refused at upload above this, for its length. Mostly bounds wall-clock time: 10,000
# pages is 100 parts, roughly 14 hours at two in flight.
PDF2MD_MAX_TOTAL_PAGES=10000

# Parts of one document in the engine at once, so a long document does not sit in front
# of everyone else's short ones for hours.
PDF2MD_PARTS_IN_FLIGHT=2

# Above this much converted Markdown, the outbox gets one file per section instead of one
# large file — so an answer cites the section rather than a document of thousands of pages.
PDF2MD_SECTION_SPLIT_THRESHOLD_BYTES=1048576
PDF2MD_SECTION_MIN_BYTES=16384           # smaller sections merge rather than stand alone
PDF2MD_SECTION_MAX_BYTES=524288          # larger ones divide at the next heading level

PDF2MD_LOG_LEVEL=INFO

# --- engine ---------------------------------------------------------------------

DOCLING_WORKERS=2                        # bounded concurrent work (FR-027)
DOCLING_MAX_DOCUMENT_TIMEOUT=2400        # 40 min per document (FR-028)
DOCLING_MAX_NUM_PAGES=2000
DOCLING_QUEUE_MAX_SIZE=100               # ≥ the 50-document batch ceiling (SC-008)
OMP_NUM_THREADS=4                        # leaves CPU headroom for Portainer (SC-011)
DOCLING_LOG_LEVEL=INFO

# --- memory ---------------------------------------------------------------------

# The container VM has ~8.38 GB in total, shared with Portainer and anything else you
# run. These are starting values: finalize DOCLING_MEM_LIMIT from `docker stats` during
# the 50-document batch run (quickstart.md V9), not by guesswork.
DOCLING_MEM_LIMIT=5g
WEB_MEM_LIMIT=512m
