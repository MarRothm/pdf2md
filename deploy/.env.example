# Stack variables for the Portainer deployment. Copy the values you need into
# Portainer's stack environment variables — this file itself contains no secrets and
# is never deployed.
#
# Values below are the ones this design chose; the reasoning for each is in
# specs/001-docling-pdf2md-stack/contracts/stack.md.

# --- required -------------------------------------------------------------------

# Any long random string. It is not a user credential: nobody is asked for it. It
# exists so that if the engine's port were ever published by mistake, the engine is
# not immediately open on the LAN (research.md R9).
#   generate with: openssl rand -hex 32
PDF2MD_ENGINE_API_KEY=

# The folder on the Mac mini that receives converted Markdown. It must exist and be
# writable before the first deploy; this is the only host-side preparation step.
OUTBOX_HOST_PATH=/Users/<you>/pdf2md-outbox

# --- images ---------------------------------------------------------------------

# Pinned by tag, never `latest`, never a `-slim` variant (those ship without model
# weights). Verified present for linux/arm64 at:
#   ghcr.io/docling-project/docling-serve-cpu:v1.18.0
#   digest sha256:6aa1b1428b5c83db2a4fc3431d99902ef115d9e1ce13eed0f716d23ed9d9a098
# The image's own environment confirms the models path this deployment relies on:
#   DOCLING_SERVE_ARTIFACTS_PATH=/opt/app-root/src/.cache/docling/models
ENGINE_IMAGE=ghcr.io/docling-project/docling-serve-cpu:v1.18.0
WEB_IMAGE=pdf2md-web:1.0.0

# --- web service ----------------------------------------------------------------

WEB_PORT=8080
PDF2MD_MAX_UPLOAD_BYTES=209715200        # 200 MB; keep at or below the engine limit
PDF2MD_JOB_TIMEOUT_SECONDS=2700          # 45 min watchdog, above the engine's own ceiling
PDF2MD_POLL_INTERVAL_SECONDS=2
PDF2MD_INBOX_RETENTION_HOURS=48          # delete an uploaded PDF this long after success
PDF2MD_FAILED_INBOX_RETENTION_DAYS=14    # keep failed uploads longer so retry stays possible
PDF2MD_SUSPECT_MIN_CHARS_PER_PAGE=50     # below this yield, report "check output" (FR-029)
PDF2MD_JOB_HISTORY_DAYS=30               # history pruning; never touches the outbox
PDF2MD_MIN_FREE_BYTES=67108864           # refuse uploads below 64 MB free, naming the folder
PDF2MD_ENGINE_HEALTH_PATH=/ready         # /ready gates on model loading; /health does not
PDF2MD_LOG_LEVEL=INFO

# --- engine ---------------------------------------------------------------------

DOCLING_WORKERS=2                        # bounded concurrent work (FR-027)
DOCLING_MAX_DOCUMENT_TIMEOUT=2400        # 40 min per document (FR-028)
DOCLING_MAX_NUM_PAGES=2000
DOCLING_QUEUE_MAX_SIZE=100               # ≥ the 50-document batch ceiling (SC-008)
OMP_NUM_THREADS=4                        # leaves CPU headroom for Portainer (SC-011)
DOCLING_LOG_LEVEL=INFO

# --- memory ---------------------------------------------------------------------

# The container VM has ~8.38 GB in total, shared with Portainer and anything else you
# run. These are starting values: finalize DOCLING_MEM_LIMIT from `docker stats` during
# the 50-document batch run (quickstart.md V9), not by guesswork.
DOCLING_MEM_LIMIT=5g
WEB_MEM_LIMIT=512m
